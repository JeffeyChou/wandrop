# Copy to .env and adjust. Everything is optional.

# First-boot admin account. Only read while no admin exists, then ignored.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed once in the logs
# (docker compose logs wandrop), or point ADMIN_PASSWORD_FILE at a Docker secret.
# Remove the password from this file once the admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Host interface/port the container is published on.
WANDROP_BIND=127.0.0.1
WANDROP_PORT=8080

# Set both when serving over HTTPS behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false
# Comma separated list, e.g. https://drop.example.com (empty = same host as request)
ALLOWED_ORIGINS=

# Optional: fixed cookie signing secret (>= 32 chars). Auto-generated in the volume otherwise.
COOKIE_SECRET=

# Lifetimes (seconds)
MSG_TTL_DEFAULT=300
CHANNEL_TTL_DEFAULT=3600
CHANNEL_TTL_MAX_ANON=86400
CHANNEL_TTL_MAX_USER=604800

# Limits. MAX_FILE_MB and USER_QUOTA_MB apply to members; admins are only bound by GLOBAL_QUOTA_MB.
MAX_FILE_MB=100
USER_QUOTA_MB=1024
CHANNEL_QUOTA_MB=1024
GLOBAL_QUOTA_MB=20480
DEFAULT_MAX_DOWNLOADS=2

# Resumable uploads are sent in chunks of this size (keep it below your proxy's body limit,
# e.g. Cloudflare's 100 MB). Unfinished uploads idle for UPLOAD_STALE_HOURS are discarded.
UPLOAD_CHUNK_MB=16
UPLOAD_STALE_HOURS=24
